{
  "project": {
    "name": "c3addon-genvidtech-marketplace",
    "description": "Genvid Construct 3 marketplace addon (plugin) SDK",
    "languages": ["typescript"]
  },
  "commands": {
    "test": "",
    "lint": "npm run lint",
    "build": "npm run build",
    "validate": "npm run lint && npm run build"
  },
  "repo": {
    "host": "github",
    "default_branch": "main"
  },
  "features": {
    "c3": true
  },
  "paths": {
    "c3project": "sample/project.c3proj",
    "docs/issue-triage.md": "wiki/issue-triage.md"
  },
  "bugTracker": {
    "kind": "github",
    "actionQuery": "gh issue list --repo GenvidTechnologies/c3addon-genvid-marketplace --state open -L 200 --json number,title,labels,body,assignees,author,createdAt,milestone",
    "comparisonQuery": "gh issue list --repo GenvidTechnologies/c3addon-genvid-marketplace --state all -L 500 --json number,title,labels,state",
    "readOne": "gh issue view {id} --repo GenvidTechnologies/c3addon-genvid-marketplace --json number,title,body,labels,comments",
    "commentsQuery": "gh issue list --repo GenvidTechnologies/c3addon-genvid-marketplace --state open -L 200 --json number,comments",
    "structureQuery": "gh issue list --repo GenvidTechnologies/c3addon-genvid-marketplace --state open -L 200 --json number,parent,subIssuesSummary",
    "refStateQuery": "gh api repos/{repo}/issues/{id} --jq '{number,state,state_reason,closed_at,pull_request:(.pull_request != null),sub_issues_summary}'",
    "triagedLabel": "triaged",
    "needsInfoLabel": "needs-info"
  }
}
